// Claude Scalper Signals — indicator companion to claude-scalper-bb-fade.pine
//
// Marks every BB-fade entry (yellow triangle) and every Bollinger band touch
// (teal/pink x-cross) so a trade can be prepared before the confirmation
// candle closes. Plots are shown around the clock; only the alertconditions
// are limited to the 10:00-19:00 Vilnius session. Five alertconditions are
// exposed: any-band touch, lower touch (prep LONG), upper touch (prep SHORT),
// long fade entry, short fade entry — create alerts from the chart's Alert
// dialog on this indicator.
//@version=6
indicator("Claude Scalper Signals", overlay=true)

// Theme
var greenColor =  #0d9488               // TailwindCSS teal-600
var redColor =    #db2777               // TailwindCSS pink-600
var whiteColor =  #e5e7eb               // TailwindCSS gray-200
var grayColor =   #9ca3af               // TailwindCSS gray-400
var signalColor = #eab308               // TailwindCSS yellow-600
var blueColor =   #06b6d4               // TailwindCSS cyan-500
var noColor = color.new(whiteColor, 100)
var blankSignalColor = color.new(signalColor, 50)

// Inputs (mirror tradingview/claude-scalper-bb-fade.pine)
bbLen  = input.int(50, "Bollinger length (1m bars)", minval=5)
bbMult = input.float(2.5, "Bollinger multiplier", step=0.25, minval=1)
sess   = input.session("1000-1900", "Trading session (Vilnius)")

inSession = not na(time(timeframe.period, sess, "Europe/Vilnius"))

// 1M Bollinger bands
basis = ta.sma(close, bbLen)
dev = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev

plot(basis, "Basis", color=blueColor)
pU = plot(upper, "Upper band", color=grayColor)
pL = plot(lower, "Lower band", color=grayColor)
fill(pU, pL, color=color.new(grayColor, 95), title="Band fill")

// Band touches: price action reaches a band — prepare a fade trade
touchLower = low <= lower
touchUpper = high >= upper
plotshape(touchLower, "Lower band touch", style=shape.xcross, location=location.belowbar, color=greenColor, size=size.tiny)
plotshape(touchUpper, "Upper band touch", style=shape.xcross, location=location.abovebar, color=redColor, size=size.tiny)

// Fade entry signals: poke through the band, then close back inside
longGo = close[1] < lower[1] and close > lower and close > open
shortGo = close[1] > upper[1] and close < upper and close < open

plotshape(longGo, "Long entry", style=shape.triangleup, location=location.belowbar, color=signalColor, size=size.tiny)
plotshape(shortGo, "Short entry", style=shape.triangledown, location=location.abovebar, color=signalColor, size=size.tiny)

// Alerts
alertcondition(inSession and (touchLower or touchUpper), "BB band touched", "EURUSD 1M: price touched a Bollinger band — prepare a fade trade")
alertcondition(inSession and touchLower, "Lower band touched", "EURUSD 1M: lower band touched — prepare a LONG fade")
alertcondition(inSession and touchUpper, "Upper band touched", "EURUSD 1M: upper band touched — prepare a SHORT fade")
alertcondition(inSession and longGo, "Long fade entry", "EURUSD 1M: LONG fade signal — close back inside lower band")
alertcondition(inSession and shortGo, "Short fade entry", "EURUSD 1M: SHORT fade signal — close back inside upper band")
