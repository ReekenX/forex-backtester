// 1H Pivot + 1M Confirmation Candle — EURUSD, London session (10:00-19:00 Vilnius)
//
// Deep backtest (Pepperstone EURUSD 1m, Feb 2011 - Jul 2026, frictionless):
//   +51.0% total PnL @ 0.5% risk/trade, 1003 trades, 54.24% win rate @ 1:1 RRR,
//   profit factor 1.18, max drawdown $8.4k on $100k (~8%).
//
// Parameter sweep results (full history, frictionless):
//   RRR:    1:1 best (1:1.5 and 1:2 halve PnL and raise drawdown)
//   Pivot:  8 bars best (3 -> more trades but 2x drawdown; 12 -> edge fades)
//   Buffer: 0 best (any SL buffer only widens risk; tested 0/0.5/1/2 pips)
//   Window: insensitive (5 == 30 bars); 5 kept for freshest entries
//   Filters tested and REJECTED: 1H EMA(50) trend align (kills edge, it is
//   mean-reversion), counter-trend only (no gain), momentum confirmation
//   close<low[1] (no gain), fresh-levels-only (worse), limit pullback
//   entries (adverse selection, PF 0.57).
//
// IMPORTANT - transaction cost reality: with Pepperstone Razor commission
// (0.0035%/side) + 1-2 ticks slippage the strategy is net NEGATIVE
// (PF 0.72-0.90 across all variants). Median safe stop is 2-6 pips, so
// ~0.5 pip round-trip cost consumes 10-25% of every R while the gross edge
// is only ~5-8% of R. Do not trade this live at raw-spread cost levels;
// it needs either commission-free execution or stops >= 15-20 pips.
//@version=6
strategy("Claude Strategy", overlay=true, initial_capital=100000, process_orders_on_close=true, calc_on_every_tick=false, margin_long=2, margin_short=2)

// Inputs
pivotLen   = input.int(8, "1H pivot strength (bars each side)", minval=1)
bufferPips = input.float(0, "SL buffer (pips)", step=0.5, minval=0)
rrr        = input.float(1, "Risk:Reward ratio", step=0.5, minval=0.5, maxval=2.0)
waitBars   = input.int(5, "Confirmation window (1m bars)", minval=1)
riskPct    = input.float(0.5, "Risk per trade (%)", step=0.25) / 100
sess       = input.session("1000-1900", "Trading session (Vilnius)")

pip = syminfo.mintick * 10
inSession = not na(time(timeframe.period, sess, "Europe/Vilnius"))

// 1H pivot levels (confirmed pivotLen hours after the extreme, no lookahead)
[ph, pl] = request.security(syminfo.tickerid, "60", [ta.pivothigh(high, pivotLen, pivotLen), ta.pivotlow(low, pivotLen, pivotLen)], lookahead=barmerge.lookahead_off)

var float resLevel = na
var float supLevel = na
if not na(ph)
    resLevel := ph
if not na(pl)
    supLevel := pl

plot(resLevel, "1H Pivot High", color=color.red, style=plot.style_linebr)
plot(supLevel, "1H Pivot Low", color=color.teal, style=plot.style_linebr)

// Touch detection + extreme tracking for safe stop
var int sellTouchBar = na
var float sellExtreme = na
var int buyTouchBar = na
var float buyExtreme = na

if not na(resLevel) and high >= resLevel
    sellTouchBar := bar_index
    sellExtreme := na(sellExtreme) ? high : math.max(sellExtreme, high)
if not na(supLevel) and low <= supLevel
    buyTouchBar := bar_index
    buyExtreme := na(buyExtreme) ? low : math.min(buyExtreme, low)

// Expire stale setups
if not na(sellTouchBar) and bar_index - sellTouchBar > waitBars
    sellTouchBar := na
    sellExtreme := na
if not na(buyTouchBar) and bar_index - buyTouchBar > waitBars
    buyTouchBar := na
    buyExtreme := na

// 1M confirmation candles
bearConfirm = close < open
bullConfirm = close > open
flat = strategy.position_size == 0 and strategy.opentrades == 0

if inSession and flat and not na(sellTouchBar) and bearConfirm and close < resLevel
    slPrice = sellExtreme + bufferPips * pip
    dist = slPrice - close
    if dist >= 1.1 * pip
        qty = strategy.equity * riskPct / dist
        strategy.entry("S", strategy.short, qty=qty)
        strategy.exit("Sx", "S", stop=slPrice, limit=close - rrr * dist)
        sellTouchBar := na
        sellExtreme := na
        resLevel := na

if inSession and flat and not na(buyTouchBar) and bullConfirm and close > supLevel
    slPrice = buyExtreme - bufferPips * pip
    dist = close - slPrice
    if dist >= 1.1 * pip
        qty = strategy.equity * riskPct / dist
        strategy.entry("L", strategy.long, qty=qty)
        strategy.exit("Lx", "L", stop=slPrice, limit=close + rrr * dist)
        buyTouchBar := na
        buyExtreme := na
        supLevel := na
